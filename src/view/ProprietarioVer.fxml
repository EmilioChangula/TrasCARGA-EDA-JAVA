<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane stylesheets="@estilo.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fx.ProprietarioVerFx">
   <children>
      <AnchorPane styleClass="card" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label alignment="CENTER" prefHeight="32.0" styleClass="titulo" text="Todos os Proprietários" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0" />

            <HBox alignment="CENTER" spacing="8.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="65.0">
               <children>
                  <TextField fx:id="txtPesquisa" prefWidth="300.0" promptText="Pesquisar por nome..." />
                  <Button onAction="#pesquisar" prefHeight="32.0" styleClass="btn-primary" text="Pesquisar" />
               </children>
            </HBox>

            <TableView fx:id="tabela" AnchorPane.bottomAnchor="35.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="115.0">
               <columns>
                  <TableColumn fx:id="colNome" text="Nome" />
                  <TableColumn fx:id="colContacto" text="Contacto" />
                  <TableColumn fx:id="colDocumento" text="Documento" />
                  <TableColumn fx:id="colAccao" sortable="false" text="Acção" />
               </columns>
            </TableView>

            <Label fx:id="lblMsg" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>