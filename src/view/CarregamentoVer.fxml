<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane stylesheets="@estilo.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fx.CarregamentoVerFx">
   <children>
      <AnchorPane styleClass="card" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label alignment="CENTER" prefHeight="32.0" styleClass="titulo" text="Carregamentos / Transportes Realizados" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0" />

            <HBox alignment="CENTER" spacing="8.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="65.0">
               <children>
                  <TextField fx:id="txtPesquisa" prefWidth="320.0" promptText="Pesquisar por cliente ou matrícula..." />
                  <Button onAction="#pesquisar" prefHeight="32.0" styleClass="btn-primary" text="Pesquisar" />
               </children>
            </HBox>

            <TableView fx:id="tabela" AnchorPane.bottomAnchor="35.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="115.0">
               <columns>
                  <TableColumn fx:id="colData" sortable="false" text="Data" />
                  <TableColumn fx:id="colCliente" sortable="false" text="Cliente" />
                  <TableColumn fx:id="colVeiculo" sortable="false" text="Veículo" />
                  <TableColumn fx:id="colProprietario" sortable="false" text="Proprietário" />
                  <TableColumn fx:id="colQuantidade" sortable="false" text="Qtd. (t)" />
                  <TableColumn fx:id="colOrigem" sortable="false" text="Origem" />
                  <TableColumn fx:id="colDestino" sortable="false" text="Destino" />
                  <TableColumn fx:id="colValor" sortable="false" text="Valor" />
               </columns>
            </TableView>

            <Label fx:id="lblMsg" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>