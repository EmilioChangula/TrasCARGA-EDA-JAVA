<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@estilo.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fx.DashboardFx">
   <children>
      <AnchorPane styleClass="card" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label alignment="CENTER" prefHeight="32.0" styleClass="titulo" text="Dashboard" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0" />

            <HBox spacing="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="80.0">
               <children>
                  <VBox styleClass="stat" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="lblProprietarios" styleClass="stat-num" text="0" />
                        <Label styleClass="stat-txt" text="Proprietários" />
                     </children>
                  </VBox>
                  <VBox styleClass="stat" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="lblVeiculos" styleClass="stat-num" text="0" />
                        <Label styleClass="stat-txt" text="Veículos" />
                     </children>
                  </VBox>
                  <VBox styleClass="stat" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="lblClientes" styleClass="stat-num" text="0" />
                        <Label styleClass="stat-txt" text="Clientes" />
                     </children>
                  </VBox>
                  <VBox styleClass="stat" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="lblCarregamentos" styleClass="stat-num" text="0" />
                        <Label styleClass="stat-txt" text="Carregamentos" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <HBox AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="230.0">
               <children>
                  <VBox styleClass="stat" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="lblTotal" styleClass="stat-num" text="0 MZN" />
                        <Label styleClass="stat-txt" text="Total arrecadado" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <HBox AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="380.0">
               <children>
                  <VBox styleClass="stat" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="lblUltimo" style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Nenhum carregamento registado" wrapText="true" />
                        <Label styleClass="stat-txt" text="Último carregamento registado" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>