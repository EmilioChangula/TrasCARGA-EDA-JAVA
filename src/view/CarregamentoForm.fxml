<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@estilo.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fx.CarregamentoFormFx">
   <children>
      <AnchorPane prefHeight="420.0" styleClass="card" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label alignment="CENTER" prefHeight="32.0" styleClass="titulo" text="Registar Carregamento" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0" />

            <HBox spacing="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="70.0">
               <children>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="campo-label" text="Cliente" />
                        <ComboBox fx:id="cmbCliente" maxWidth="Infinity" promptText="-- Seleccionar --" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="campo-label" text="Veículo" />
                        <ComboBox fx:id="cmbVeiculo" maxWidth="Infinity" promptText="-- Seleccionar --" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="campo-label" text="Proprietário do veículo" />
                        <TextField fx:id="txtProprietario" editable="false" focusTraversable="false" maxWidth="Infinity" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="campo-label" text="Capacidade máxima" />
                        <TextField fx:id="txtCapacidade" editable="false" focusTraversable="false" maxWidth="Infinity" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <HBox spacing="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="160.0">
               <children>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="campo-label" text="Quantidade (toneladas)" />
                        <TextField fx:id="txtQuantidade" maxWidth="Infinity" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="campo-label" text="Local de origem" />
                        <TextField fx:id="txtOrigem" maxWidth="Infinity" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="campo-label" text="Destino" />
                        <TextField fx:id="txtDestino" maxWidth="Infinity" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="campo-label" text="Data" />
                        <DatePicker fx:id="dpData" maxWidth="Infinity" prefHeight="32.0" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <HBox spacing="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="250.0">
               <children>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="campo-label" text="Valor cobrado (MZN)" />
                        <TextField fx:id="txtValor" maxWidth="Infinity" />
                     </children>
                  </VBox>
                  <VBox HBox.hgrow="ALWAYS" />
                  <VBox HBox.hgrow="ALWAYS" />
                  <VBox HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <HBox alignment="CENTER" spacing="10.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="330.0">
               <children>
                  <Button onAction="#guardar" prefHeight="30.0" prefWidth="120.0" styleClass="btn-primary" text="Registar" />
                  <Button onAction="#limpar" prefHeight="30.0" prefWidth="120.0" styleClass="btn-primary" text="Limpar" />
               </children>
            </HBox>

            <Label fx:id="lblMsg" alignment="CENTER" maxWidth="Infinity" wrapText="true" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="378.0" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>